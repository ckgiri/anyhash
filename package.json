{
  "name": "anyhash",
  "version": "1.1.0",
  "description": "Stable hash of any JavaScript value: objects (any key order), Map, Set, Date, typed arrays, class instances, circular references. Fast 128-bit hash or SHA-256. Zero dependencies.",
  "keywords": [
    "hash",
    "object-hash",
    "stable-hash",
    "hash-object",
    "deterministic",
    "fingerprint",
    "checksum",
    "murmurhash",
    "sha256",
    "cache-key",
    "memoize",
    "deep-equal"
  ],
  "license": "MIT",
  "author": "ckgiri",
  "homepage": "https://github.com/ckgiri/anyhash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckgiri/anyhash.git"
  },
  "bugs": {
    "url": "https://github.com/ckgiri/anyhash/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
